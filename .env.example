# Supabase Projekt-Einstellungen
# Werte aus: Supabase Dashboard → Settings → API

# Projekt-URL (z.B. https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/Public Key (sicher für das Frontend – RLS schützt die Daten)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NICHT ins Frontend: Service Role Key (nur für Server-seitige Admin-Operationen)
# SUPABASE_SERVICE_ROLE_KEY=...
